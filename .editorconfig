root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,glsl,frag,vert}]
indent_style = space
indent_size = 4

[*.{ps1,sh}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,html,css}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
